// The Keyboard and touchpad group of the settings window.

import { LineEdit, Switch } from "std-widgets.slint";
import { BrightnessRange, Card, GroupTitle, Row, SendingSlider, Show, SwatchItem, Theme } from "parts.slint";

export component KeyboardGroup inherits VerticalLayout {
    in property <int> brightness;
    in property <bool> colours-enabled;
    in property <[SwatchItem]> swatches;
    in property <bool> custom-selected;
    in property <string> custom-hex;
    in-out property <bool> touchpad-on;
    // `false` greys the touchpad switch: its state can't be read.
    in property <bool> touchpad-known: true;
    in property <bool> logo-shown;
    in-out property <bool> logo-on;
    in property <bool> vapor-light-shown;
    in-out property <bool> vapor-light-on;
    in property <color> accent;

    callback move-brightness(int);
    callback pick-swatch(int);
    callback pick-custom(string);
    callback toggle-touchpad();
    callback toggle-logo();
    callback toggle-vapor-light();

    // A swatch, the flyout or a re-apply changed the colour: show it.
    changed custom-hex => {
        custom-field.text = root.custom-hex;
    }

    // The laptop's brightness changed (a send, the other window, a
    // re-apply): the slider goes there, even after a drag broke its binding.
    changed brightness => {
        brightness-slider.value = root.brightness;
    }

    // Called when the window is shown or focused: a drag cut short left the
    // slider at a value never sent.
    public function show-brightness() {
        brightness-slider.value = root.brightness;
    }

    // The same spacing as the window's own list, so nothing moves.
    spacing: 4px;

    GroupTitle { text: "Keyboard and touchpad"; }
    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: "Brightness";
                    width: 110px;
                    vertical-alignment: center;
                }
                brightness-slider := SendingSlider {
                    accessible-label: "Brightness";
                    minimum: BrightnessRange.minimum;
                    maximum: BrightnessRange.maximum;
                    step: BrightnessRange.step;
                    value: root.brightness;
                    // Sent only when the slider is let go. Then the slider goes
                    // back to what the laptop has, so a failed send does not
                    // leave it at the new value.
                    released(value) => {
                        root.move-brightness(round(value));
                        self.value = root.brightness;
                    }
                }
                brightness-percent := Text {
                    // Follows the slider, also while it is dragged.
                    text: Show.brightness(round(brightness-slider.value));
                    width: 84px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.secondary;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                opacity: root.colours-enabled ? 1 : 0.5;
                alignment: start;
                for swatch[index] in root.swatches: Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: swatch.colour;
                    border-width: swatch.selected ? 3px : 1px;
                    border-color: swatch.selected ? root.accent : #00000029;
                    accessible-role: button;
                    accessible-label: "Colour " + (index + 1);
                    accessible-enabled: root.colours-enabled;
                    TouchArea {
                        enabled: root.colours-enabled;
                        clicked => { root.pick-swatch(index); }
                    }
                }
                Text {
                    text: "Custom";
                    vertical-alignment: center;
                    color: root.custom-selected ? root.accent : Theme.secondary;
                }
                custom-field := LineEdit {
                    accessible-label: "Custom colour";
                    width: 110px;
                    enabled: root.colours-enabled;
                    text: root.custom-hex;
                    placeholder-text: "#RRGGBB";
                    // Typing breaks the text binding, so each handler
                    // below shows the colour in use again: the new one,
                    // or the last good one if the text was not a colour.
                    accepted(text) => {
                        root.pick-custom(text);
                        self.text = root.custom-hex;
                    }
                    changed has-focus => {
                        if !self.has-focus {
                            self.text = root.custom-hex;
                        }
                    }
                }
            }
        }
    }
    Row {
        title: "Touchpad";
        note: !root.touchpad-known ? "Unknown" : root.touchpad-on ? "Turn off when you use a mouse" : "Off";
        Switch {
            accessible-label: "Touchpad";
            enabled: root.touchpad-known;
            checked <=> root.touchpad-on;
            toggled => { root.toggle-touchpad(); }
        }
    }
    if root.logo-shown: Row {
        title: "Lid logo";
        note: root.logo-on ? "On" : "Off";
        Switch {
            accessible-label: "Lid logo";
            checked <=> root.logo-on;
            toggled => { root.toggle-logo(); }
        }
    }
    if root.vapor-light-shown: Row {
        title: "Vapor chamber light";
        note: root.vapor-light-on ? "Follows the keyboard brightness" : "Off";
        Switch {
            accessible-label: "Vapor chamber light";
            checked <=> root.vapor-light-on;
            toggled => { root.toggle-vapor-light(); }
        }
    }
}
