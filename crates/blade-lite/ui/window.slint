// The settings window: mockup B, one page of groups under a device header.
// Rust fills every property from the view models, and each callback becomes
// a view-model command.

import { Button, LineEdit, Palette, ScrollView, Slider, Switch } from "std-widgets.slint";

export struct Stat {
    label: string,
    value: string,
}

export struct Choice {
    label: string,
    selected: bool,
    enabled: bool,
}

export struct SliderRow {
    label: string,
    stops: int,
    position: int,
    text: string,
}

export struct SwatchItem {
    colour: color,
    selected: bool,
}

global Theme {
    out property <brush> card: Palette.color-scheme == ColorScheme.dark ? #ffffff0d : #ffffffb8;
    out property <brush> stroke: #0000000f;
    out property <brush> secondary: Palette.foreground.transparentize(0.35);
}

// One white card with a thin border, as in Windows Settings.
component Card inherits Rectangle {
    background: Theme.card;
    border-color: Theme.stroke;
    border-width: 1px;
    border-radius: 4px;
}

// A settings row: title and note on the left, the control on the right.
component Row inherits Card {
    in property <string> title;
    in property <string> note;
    min-height: 68px;
    vertical-stretch: 0;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Text { text: root.title; }
            if root.note != "": Text {
                text: root.note;
                font-size: 12px;
                color: Theme.secondary;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Buttons side by side; the selected one is filled with the accent.
component Segments inherits Rectangle {
    in property <[Choice]> items;
    in property <bool> enabled: true;
    in property <color> accent;
    callback picked(int);
    border-color: Theme.stroke;
    border-width: 1px;
    border-radius: 4px;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[index] in root.items: Rectangle {
            property <bool> on: root.enabled && item.enabled;
            min-width: 64px;
            height: 28px;
            border-radius: 3px;
            background: item.selected ? root.accent : (touch.has-hover && self.on ? #0000000a : transparent);
            Text {
                text: item.label;
                color: item.selected ? white : (parent.on ? Palette.foreground : Theme.secondary);
                horizontal-alignment: center;
            }
            touch := TouchArea {
                enabled: parent.on;
                clicked => { root.picked(index); }
            }
        }
    }
}

component GroupTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 20px;
    padding-bottom: 6px;
    Text {
        text: root.text;
        font-weight: 600;
    }
}

component StatCell inherits VerticalLayout {
    in property <Stat> stat;
    Text {
        text: root.stat.label;
        font-size: 12px;
        color: Theme.secondary;
    }
    Text {
        text: root.stat.value;
        font-size: 16px;
        font-weight: 600;
    }
}

export component MainWindow inherits Window {
    // Header
    in property <string> device;
    in property <string> preset;
    in property <string> power;
    in property <[Stat]> stats-top;
    in property <[Stat]> stats-bottom;
    // Display
    in property <[Choice]> rates;
    in property <bool> rates-enabled;
    in property <string> rate-note;
    in property <bool> sixty-hz-on-battery;
    in property <[Choice]> native-modes;
    in property <string> native-note;
    in property <bool> restart-infobar;
    // Performance
    in property <[Choice]> presets;
    in property <[SliderRow]> sliders;
    // Keyboard and touchpad
    in property <int> brightness;
    in property <string> brightness-text;
    in property <bool> colours-enabled;
    in property <[SwatchItem]> swatches;
    in property <bool> custom-selected;
    in property <string> custom-hex;
    in property <bool> touchpad-on;
    // Everywhere
    in property <color> accent: #0078d4;
    in property <string> error;

    callback pick-rate(int);
    callback toggle-sixty-hz();
    callback pick-native(int);
    callback pick-preset(int);
    callback move-slider(int, int);
    callback move-brightness(int);
    callback pick-swatch(int);
    callback pick-custom(string);
    callback toggle-touchpad();

    title: "Blade Lite";
    preferred-width: 760px;
    preferred-height: 820px;
    min-width: 560px;
    // Mica shows only through a transparent window.
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    ScrollView {
        VerticalLayout {
            padding: 24px;
            padding-top: 16px;
            spacing: 4px;

            if root.error != "": Rectangle {
                background: #fde7e9;
                border-radius: 4px;
                HorizontalLayout {
                    padding: 12px;
                    Text {
                        text: root.error;
                        color: #c42b1c;
                        wrap: word-wrap;
                    }
                }
            }

            // Header
            Card {
                border-radius: 8px;
                HorizontalLayout {
                    padding: 20px;
                    spacing: 28px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.device;
                            font-size: 20px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.preset;
                            color: Theme.secondary;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                border-radius: 10px;
                                background: root.power == "On battery" ? #fff4ce : #00000009;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    Text {
                                        text: root.power;
                                        font-size: 12px;
                                        color: root.power == "On battery" ? #9d5d00 : Theme.secondary;
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 28px;
                            for stat in root.stats-top: StatCell { stat: stat; width: 72px; }
                        }
                        HorizontalLayout {
                            spacing: 28px;
                            for stat in root.stats-bottom: StatCell { stat: stat; width: 72px; }
                        }
                    }
                }
            }

            // Display
            GroupTitle { text: "Display"; }
            Row {
                title: "Refresh rate";
                note: root.rate-note;
                Segments {
                    items: root.rates;
                    enabled: root.rates-enabled;
                    accent: root.accent;
                    picked(index) => { root.pick-rate(index); }
                }
            }
            Row {
                title: "Switch to 60 Hz on battery";
                note: "Goes back to your rate when you plug in";
                Switch {
                    checked: root.sixty-hz-on-battery;
                    toggled => { root.toggle-sixty-hz(); }
                }
            }
            Row {
                title: "Native display mode";
                note: root.native-note;
                Segments {
                    items: root.native-modes;
                    accent: root.accent;
                    picked(index) => { root.pick-native(index); }
                }
            }
            if root.restart-infobar: Rectangle {
                background: #fff4ce;
                border-radius: 4px;
                HorizontalLayout {
                    padding: 12px;
                    Text { text: "Restart to apply. The display switches mode after a restart."; }
                }
            }

            // Performance
            GroupTitle { text: "Performance"; }
            Row {
                title: "Performance mode";
                note: "Sets CPU, GPU power and fan behaviour";
                Segments {
                    items: root.presets;
                    accent: root.accent;
                    picked(index) => { root.pick-preset(index); }
                }
            }
            if root.sliders.length > 0: Card {
                VerticalLayout {
                    padding: 16px;
                    padding-left: 52px;
                    spacing: 12px;
                    for row[index] in root.sliders: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: row.label;
                            width: 110px;
                            vertical-alignment: center;
                        }
                        Slider {
                            minimum: 0;
                            maximum: row.stops - 1;
                            step: 1;
                            value: row.position;
                            released(value) => { root.move-slider(index, round(value)); }
                        }
                        Text {
                            text: row.text;
                            width: 84px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: Theme.secondary;
                        }
                    }
                }
            }

            // Keyboard and touchpad
            GroupTitle { text: "Keyboard and touchpad"; }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Brightness";
                            width: 110px;
                            vertical-alignment: center;
                        }
                        Slider {
                            minimum: 0;
                            maximum: 100;
                            step: 5;
                            value: root.brightness;
                            released(value) => { root.move-brightness(round(value)); }
                        }
                        Text {
                            text: root.brightness-text;
                            width: 84px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: Theme.secondary;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        opacity: root.colours-enabled ? 1 : 0.5;
                        alignment: start;
                        for swatch[index] in root.swatches: Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: swatch.colour;
                            border-width: swatch.selected ? 3px : 1px;
                            border-color: swatch.selected ? root.accent : #00000029;
                            TouchArea {
                                enabled: root.colours-enabled;
                                clicked => { root.pick-swatch(index); }
                            }
                        }
                        Text {
                            text: "Custom";
                            vertical-alignment: center;
                            color: root.custom-selected ? root.accent : Theme.secondary;
                        }
                        LineEdit {
                            width: 110px;
                            enabled: root.colours-enabled;
                            text: root.custom-hex;
                            placeholder-text: "#RRGGBB";
                            accepted(text) => { root.pick-custom(text); }
                        }
                    }
                }
            }
            Row {
                title: "Touchpad";
                note: root.touchpad-on ? "Turn off when you use a mouse" : "Off";
                Switch {
                    checked: root.touchpad-on;
                    toggled => { root.toggle-touchpad(); }
                }
            }
            // Takes the spare height, so the groups keep their own.
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// The tray flyout: a frameless popup above the tray icon.
export component FlyoutWindow inherits Window {
    in property <string> device;
    in property <string> power;
    in property <[Choice]> presets;
    in property <[Choice]> rates;
    in property <bool> rates-enabled;
    in property <int> brightness;
    in property <string> brightness-text;
    in property <bool> touchpad-on;
    in property <bool> reset-enabled;
    in property <color> accent: #0078d4;

    callback pick-preset(int);
    callback pick-rate(int);
    callback move-brightness(int);
    callback toggle-touchpad();
    callback reset();
    callback open-window();

    title: "Blade Lite";
    no-frame: true;
    always-on-top: true;
    width: 400px;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            Text {
                text: root.device;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.power;
                font-size: 12px;
                color: Theme.secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        Text {
            text: "Performance";
            font-size: 12px;
            color: Theme.secondary;
        }
        Segments {
            items: root.presets;
            accent: root.accent;
            picked(index) => { root.pick-preset(index); }
        }
        Text {
            text: "Refresh rate";
            font-size: 12px;
            color: Theme.secondary;
        }
        Segments {
            items: root.rates;
            enabled: root.rates-enabled;
            accent: root.accent;
            picked(index) => { root.pick-rate(index); }
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Keyboard light";
                width: 110px;
                vertical-alignment: center;
            }
            Slider {
                minimum: 0;
                maximum: 100;
                step: 5;
                value: root.brightness;
                released(value) => { root.move-brightness(round(value)); }
            }
            Text {
                text: root.brightness-text;
                width: 44px;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.secondary;
            }
        }
        HorizontalLayout {
            Text {
                text: "Touchpad";
                vertical-alignment: center;
            }
            Switch {
                checked: root.touchpad-on;
                toggled => { root.toggle-touchpad(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: "Reset to Balanced";
                enabled: root.reset-enabled;
                clicked => { root.reset(); }
            }
            Button {
                text: "Open window";
                primary: true;
                clicked => { root.open-window(); }
            }
        }
    }
}
