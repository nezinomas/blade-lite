// The settings window: mockup B, one page of groups under a device header.
// Rust fills every property from the view models, and each callback becomes
// a view-model command. Each group lives in its own file.

import { Button, ScrollView, Slider, Switch } from "std-widgets.slint";
import { BrightnessRange, Choice, Segments, Show, SliderRow, Stat, SwatchItem, Theme } from "parts.slint";
import { Header } from "header.slint";
import { DisplayGroup } from "display.slint";
import { PerformanceGroup } from "performance.slint";
import { KeyboardGroup } from "keyboard.slint";
import { SettingsGroup } from "settings.slint";

// Rust uses these rows, so they stay exported from this file.
export { Choice, SliderRow, Stat, SwatchItem }

export component MainWindow inherits Window {
    // Header
    in property <string> device;
    in property <string> preset;
    in property <string> power;
    in property <string> health;
    in property <[Stat]> stats-top;
    in property <[Stat]> stats-bottom;
    // Display
    in property <[Choice]> rates;
    in property <bool> rates-enabled;
    in property <string> rate-note;
    in-out property <bool> sixty-hz-on-battery;
    in property <[Choice]> native-modes;
    in property <string> native-note;
    in property <bool> restart-infobar;
    // Performance
    in property <[Choice]> presets;
    in property <[SliderRow]> sliders;
    in property <bool> charge-limit-shown;
    in-out property <bool> charge-limit-on;
    in property <string> charge-limit-note;
    // Keyboard and touchpad
    in property <int> brightness;
    in property <bool> colours-enabled;
    in property <[SwatchItem]> swatches;
    in property <bool> custom-selected;
    in property <string> custom-hex;
    in-out property <bool> touchpad-on;
    in property <bool> touchpad-known: true;
    in property <bool> logo-shown;
    in-out property <bool> logo-on;
    in property <bool> vapor-light-shown;
    in-out property <bool> vapor-light-on;
    // Everywhere
    in property <color> accent: #0078d4;
    in property <string> error;

    callback pick-rate(int);
    callback toggle-sixty-hz();
    callback pick-native(int);
    callback pick-preset(int);
    callback move-slider(int, int);
    callback toggle-charge-limit();
    callback move-brightness(int);
    callback pick-swatch(int);
    callback pick-custom(string);
    callback toggle-touchpad();
    callback toggle-logo();
    callback toggle-vapor-light();
    callback export-settings();
    callback import-settings();
    callback reset-settings();

    // Called when the window is shown or focused: the brightness slider goes back to
    // what the laptop has.
    public function show-brightness() {
        keyboard.show-brightness();
    }

    title: "Blade Lite";
    preferred-width: 760px;
    preferred-height: 820px;
    min-width: 560px;
    // Mica shows only through a transparent window.
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    ScrollView {
        VerticalLayout {
            padding: 24px;
            padding-top: 16px;
            spacing: 4px;

            if root.error != "": Rectangle {
                background: #fde7e9;
                border-radius: 4px;
                HorizontalLayout {
                    padding: 12px;
                    Text {
                        text: root.error;
                        color: #c42b1c;
                        wrap: word-wrap;
                    }
                }
            }

            Header {
                device: root.device;
                preset: root.preset;
                power: root.power;
                health: root.health;
                stats-top: root.stats-top;
                stats-bottom: root.stats-bottom;
            }

            DisplayGroup {
                rates: root.rates;
                rates-enabled: root.rates-enabled;
                rate-note: root.rate-note;
                sixty-hz-on-battery <=> root.sixty-hz-on-battery;
                native-modes: root.native-modes;
                native-note: root.native-note;
                restart-infobar: root.restart-infobar;
                accent: root.accent;
                pick-rate(index) => { root.pick-rate(index); }
                toggle-sixty-hz => { root.toggle-sixty-hz(); }
                pick-native(index) => { root.pick-native(index); }
            }

            PerformanceGroup {
                presets: root.presets;
                sliders: root.sliders;
                charge-limit-shown: root.charge-limit-shown;
                charge-limit-on <=> root.charge-limit-on;
                charge-limit-note: root.charge-limit-note;
                accent: root.accent;
                pick-preset(index) => { root.pick-preset(index); }
                move-slider(index, position) => { root.move-slider(index, position); }
                toggle-charge-limit => { root.toggle-charge-limit(); }
            }

            keyboard := KeyboardGroup {
                brightness: root.brightness;
                colours-enabled: root.colours-enabled;
                swatches: root.swatches;
                custom-selected: root.custom-selected;
                custom-hex: root.custom-hex;
                touchpad-on <=> root.touchpad-on;
                touchpad-known: root.touchpad-known;
                logo-shown: root.logo-shown;
                logo-on <=> root.logo-on;
                vapor-light-shown: root.vapor-light-shown;
                vapor-light-on <=> root.vapor-light-on;
                accent: root.accent;
                move-brightness(value) => { root.move-brightness(value); }
                pick-swatch(index) => { root.pick-swatch(index); }
                pick-custom(text) => { root.pick-custom(text); }
                toggle-touchpad => { root.toggle-touchpad(); }
                toggle-logo => { root.toggle-logo(); }
                toggle-vapor-light => { root.toggle-vapor-light(); }
            }

            SettingsGroup {
                export-settings => { root.export-settings(); }
                import-settings => { root.import-settings(); }
                reset-settings => { root.reset-settings(); }
            }

            // Takes the spare height, so the groups keep their own.
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// The tray flyout: a frameless popup above the tray icon.
export component FlyoutWindow inherits Window {
    in property <string> device;
    in property <string> power;
    in property <[Choice]> presets;
    in property <[Choice]> rates;
    in property <bool> rates-enabled;
    in-out property <bool> sixty-hz-on-battery;
    in property <int> brightness;
    in-out property <bool> touchpad-on;
    in property <bool> touchpad-known: true;
    in property <bool> reset-enabled;
    in property <color> accent: #0078d4;

    // The laptop's brightness changed (a send, the other window, a
    // re-apply): the slider goes there, even after a drag broke its binding.
    changed brightness => {
        brightness-slider.value = root.brightness;
    }

    // Called when the flyout is shown: a drag cut short or a Narrator
    // set-value left the slider at a value never sent.
    public function show-brightness() {
        brightness-slider.value = root.brightness;
    }

    callback pick-preset(int);
    callback pick-rate(int);
    callback toggle-sixty-hz();
    callback move-brightness(int);
    callback toggle-touchpad();
    callback reset();
    callback open-window();

    title: "Blade Lite";
    no-frame: true;
    always-on-top: true;
    width: 400px;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            Text {
                text: root.device;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.power;
                font-size: 12px;
                color: Theme.secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        Text {
            text: "Performance";
            font-size: 12px;
            color: Theme.secondary;
        }
        Segments {
            items: root.presets;
            accent: root.accent;
            picked(index) => { root.pick-preset(index); }
        }
        Text {
            text: "Refresh rate";
            font-size: 12px;
            color: Theme.secondary;
        }
        Segments {
            items: root.rates;
            enabled: root.rates-enabled;
            accent: root.accent;
            picked(index) => { root.pick-rate(index); }
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Switch to 60 Hz on battery";
                vertical-alignment: center;
            }
            Switch {
                accessible-label: "Switch to 60 Hz on battery";
                checked <=> root.sixty-hz-on-battery;
                toggled => { root.toggle-sixty-hz(); }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Keyboard light";
                width: 110px;
                vertical-alignment: center;
            }
            brightness-slider := Slider {
                accessible-label: "Keyboard light";
                minimum: BrightnessRange.minimum;
                maximum: BrightnessRange.maximum;
                step: BrightnessRange.step;
                value: root.brightness;
                // Sent only when the slider is let go. Then the slider goes
                // back to what the laptop has, so a failed send does not
                // leave it at the new value.
                released(value) => {
                    root.move-brightness(round(value));
                    self.value = root.brightness;
                }
            }
            brightness-percent := Text {
                // Follows the slider, also while it is dragged.
                text: Show.brightness(round(brightness-slider.value));
                width: 44px;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.secondary;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Touchpad";
                vertical-alignment: center;
            }
            Switch {
                accessible-label: "Touchpad";
                enabled: root.touchpad-known;
                checked <=> root.touchpad-on;
                toggled => { root.toggle-touchpad(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: "Reset to Balanced";
                enabled: root.reset-enabled;
                clicked => { root.reset(); }
            }
            Button {
                text: "Open window";
                primary: true;
                clicked => { root.open-window(); }
            }
        }
    }
}

// The power mode popup above the taskbar clock: semi-transparent black, no
// focus, no clicks. It fades in when shown and out when Rust clears shown.
export component ModePopup inherits Window {
    in property <string> caption: "Power mode";
    in property <string> mode;
    in property <bool> shown;
    in property <color> accent: #0078d4;

    title: "Blade Lite";
    no-frame: true;
    always-on-top: true;
    width: 240px;
    height: 72px;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";

    Rectangle {
        background: #000000c0;
        border-radius: 8px;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: 250ms; easing: ease-out; }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            Rectangle {
                width: 4px;
                height: 36px;
                border-radius: 2px;
                background: root.accent;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.caption;
                    font-size: 12px;
                    color: #ffffffa6;
                }
                Text {
                    text: root.mode;
                    font-size: 20px;
                    font-weight: 600;
                    color: white;
                }
            }
        }
    }
}
