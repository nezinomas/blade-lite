// The shared pieces of the windows: the data rows Rust fills, the theme
// colours, and the small building blocks every group uses.

import { Palette, Slider } from "std-widgets.slint";

export struct Stat {
    label: string,
    value: string,
}

export struct Choice {
    label: string,
    selected: bool,
    enabled: bool,
}

export struct SliderRow {
    label: string,
    stops: int,
    position: int,
    // Where the slider is: the laptop's stop, or a drag or arrow key not
    // yet sent. The slider is bound to it both ways, so Rust can put the
    // slider back at once without making the row again.
    value: float,
    text: string,
    // The value at each stop, as text, for the text to follow a drag.
    texts: [string],
}

export struct SwatchItem {
    colour: color,
    selected: bool,
}

export global Theme {
    out property <brush> card: Palette.color-scheme == ColorScheme.dark ? #ffffff0d : #ffffffb8;
    out property <brush> stroke: #0000000f;
    out property <brush> secondary: Palette.foreground.transparentize(0.35);
}

// Values as the window and the flyout write them.
export global Show {
    // The keyboard brightness: "Off" at 0, else the percent.
    public pure function brightness(percent: int) -> string {
        percent == 0 ? "Off" : percent + "%"
    }
}

// The keyboard brightness slider's range, in percent, in the window and the flyout.
export global BrightnessRange {
    out property <int> minimum: 0;
    out property <int> maximum: 100;
    out property <int> step: 5;
}

// One white card with a thin border, as in Windows Settings.
export component Card inherits Rectangle {
    background: Theme.card;
    border-color: Theme.stroke;
    border-width: 1px;
    border-radius: 4px;
}

// A settings row: title and note on the left, the control on the right.
export component Row inherits Card {
    in property <string> title;
    in property <string> note;
    min-height: 68px;
    vertical-stretch: 0;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Text { text: root.title; }
            if root.note != "": Text {
                text: root.note;
                font-size: 12px;
                color: Theme.secondary;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Buttons side by side; the selected one is filled with the accent.
export component Segments inherits Rectangle {
    in property <[Choice]> items;
    in property <bool> enabled: true;
    in property <color> accent;
    callback picked(int);
    border-color: Theme.stroke;
    border-width: 1px;
    border-radius: 4px;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[index] in root.items: Rectangle {
            property <bool> on: root.enabled && item.enabled;
            accessible-role: button;
            accessible-label: item.label;
            accessible-enabled: self.on;
            min-width: 64px;
            height: 28px;
            border-radius: 3px;
            background: item.selected ? root.accent : (touch.has-hover && self.on ? #0000000a : transparent);
            Text {
                text: item.label;
                color: item.selected ? white : (parent.on ? Palette.foreground : Theme.secondary);
                horizontal-alignment: center;
            }
            touch := TouchArea {
                enabled: parent.on;
                clicked => { root.picked(index); }
            }
        }
    }
}

export component GroupTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 20px;
    padding-bottom: 6px;
    Text {
        text: root.text;
        font-weight: 600;
    }
}

// A group title that opens and closes its group (ticket 227): a click on
// it, Enter or Space while it has the keyboard focus, or Narrator's invoke,
// switches `open`.
export component GroupHeader inherits VerticalLayout {
    in property <string> text;
    in-out property <bool> open;
    // Narrator's focus action lands on the header; the keys go to the scope.
    forward-focus: focus;
    padding-top: 20px;
    padding-bottom: 6px;
    accessible-role: button;
    accessible-label: root.text;
    // Not `accessible-expandable`: AccessKit then drops the invoke pattern,
    // and Slint 1.18 has no collapse action, so Narrator could open the
    // group but never close it. The state is told in the description, and
    // as a toggle: AccessKit then gives the toggle pattern, whose toggle runs
    // the default action, and raises a toggle-state event on a change, which
    // Narrator should say (laptop check, ticket 232). It did not say a
    // changed description.
    accessible-description: root.open ? "Open" : "Closed";
    accessible-checkable: true;
    accessible-checked: root.open;
    accessible-action-default => { root.open = !root.open; }
    Rectangle {
        // The focus ring shows only while the keyboard is on the header. It
        // stands a little out, so the title stays in line with the others.
        Rectangle {
            x: -6px;
            y: -3px;
            width: parent.width + 12px;
            height: parent.height + 6px;
            border-radius: 4px;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Palette.foreground;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.text;
                font-weight: 600;
                vertical-alignment: center;
            }
            // A chevron: down when closed, up when open.
            VerticalLayout {
                alignment: center;
                Path {
                    width: 10px;
                    height: 7px;
                    // A fixed view box, so the stroke is not scaled.
                    viewbox-width: 10;
                    viewbox-height: 7;
                    commands: root.open ? "M 0 6 L 5 1 L 10 6" : "M 0 1 L 5 6 L 10 1";
                    stroke: Palette.foreground;
                    stroke-width: 1px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        focus := FocusScope {
            key-pressed(event) => {
                // Not on a held key's repeat, nor with Ctrl or Alt (Alt+Space
                // is the window menu).
                if (event.text == Key.Return || event.text == " ") && !event.repeat
                    && !event.modifiers.control && !event.modifiers.alt {
                    root.open = !root.open;
                    return accept;
                }
                reject
            }
        }
        // Above the focus scope, so it gets the clicks.
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open = !root.open; }
        }
    }
}

export component StatCell inherits VerticalLayout {
    in property <Stat> stat;
    Text {
        text: root.stat.label;
        font-size: 12px;
        color: Theme.secondary;
    }
    Text {
        text: root.stat.value;
        font-size: 16px;
        font-weight: 600;
    }
}

// A slider whose Narrator set-value, increase and decrease are let go at
// once, as an arrow key is on its release: `released` sends the value,
// and nothing is left shown unsent. So each step is one send, as each
// arrow key press is. A set-value off the slider, between two steps, or
// not a number, and any action on a disabled slider, do nothing. `changed` is not called:
// no slider here uses it.
export component SendingSlider inherits Slider {
    // The step Narrator is told is the one the slider takes.
    accessible-value-step: root.step;
    accessible-action-set-value(v) => {
        if v.is-float() {
            root.let-go-at(v.to-float());
        }
    }
    // To the next step up or down, also from a value between two steps
    // (a drag can leave one).
    accessible-action-increment => {
        root.let-go-at(min(root.maximum, root.stop(floor(root.stops-from-minimum() + 1))));
    }
    accessible-action-decrement => {
        root.let-go-at(max(root.minimum, root.stop(ceil(root.stops-from-minimum() - 1))));
    }

    pure function stops-from-minimum() -> float {
        (root.value - root.minimum) / root.step
    }

    pure function stop(n: float) -> float {
        n * root.step + root.minimum
    }

    function let-go-at(value: float) {
        // Also false for NaN.
        let on-a-step = root.stop(round((value - root.minimum) / root.step)) == value;
        if root.enabled && on-a-step && value >= root.minimum && value <= root.maximum
            && value != root.value {
            root.value = value;
            root.released(value);
        }
    }
}
