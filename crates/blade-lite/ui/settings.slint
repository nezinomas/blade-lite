// The Settings group of the settings window: export, import and reset;
// and the About group. Both start closed; a click on the title opens them.

import { AboutSlint, Button } from "std-widgets.slint";
import { Card, GroupHeader, Row } from "parts.slint";

export component SettingsGroup inherits VerticalLayout {
    callback export-settings();
    callback import-settings();
    callback reset-settings();
    in-out property <bool> open: false;

    // The same spacing as the window's own list, so nothing moves.
    spacing: 4px;

    GroupHeader {
        text: "Settings";
        open <=> root.open;
    }
    if root.open: Row {
        title: "Export or import settings";
        note: "A file to keep, or to load again later";
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Export…";
                clicked => { root.export-settings(); }
            }
            Button {
                text: "Import…";
                clicked => { root.import-settings(); }
            }
        }
    }
    if root.open: Row {
        title: "Reset to defaults";
        note: "Balanced, white keys, lid logo on, 60 Hz switch off";
        Button {
            text: "Reset";
            clicked => { root.reset-settings(); }
        }
    }
}

// The Slint credit, which Slint's royalty-free licence asks for (ticket 95).
// It shows when the user opens the About group.
export component AboutGroup inherits VerticalLayout {
    in-out property <bool> open: false;
    spacing: 4px;

    GroupHeader {
        text: "About";
        open <=> root.open;
    }
    if root.open: Card {
        vertical-stretch: 0;
        AboutSlint {}
    }
}
