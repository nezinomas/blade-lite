// The Performance group of the settings window.

import { Switch } from "std-widgets.slint";
import { Card, Choice, GroupTitle, Row, SendingSlider, Segments, SliderRow, Theme } from "parts.slint";

export component PerformanceGroup inherits VerticalLayout {
    in property <[Choice]> presets;
    in property <[SliderRow]> sliders;
    in property <bool> charge-limit-shown;
    in-out property <bool> charge-limit-on;
    in property <string> charge-limit-note;
    // Such as "99%, 86 cycles". Empty when the battery health is not known.
    in property <string> health;
    in property <color> accent;

    callback pick-preset(int);
    callback move-slider(int, int);
    callback toggle-charge-limit();

    // The same spacing as the window's own list, so nothing moves.
    spacing: 4px;

    GroupTitle { text: "Performance"; }
    Row {
        title: "Performance mode";
        note: "Sets CPU, GPU power and fan behaviour";
        Segments {
            items: root.presets;
            accent: root.accent;
            picked(index) => { root.pick-preset(index); }
        }
    }
    if root.sliders.length > 0: Card {
        VerticalLayout {
            padding: 16px;
            padding-left: 52px;
            spacing: 12px;
            // A change (a send, a preset, the window shown or focused) updates
            // a row in place, it does not make it again, so a focused slider
            // keeps the focus.
            for row[index] in root.sliders: HorizontalLayout {
                spacing: 12px;
                Text {
                    text: row.label;
                    width: 110px;
                    vertical-alignment: center;
                }
                slider := SendingSlider {
                    accessible-label: row.label;
                    minimum: 0;
                    maximum: row.stops - 1;
                    step: 1;
                    value <=> row.value;
                    // Sent only when the slider is let go. Then the slider goes
                    // back to what the laptop has, so a release that sends
                    // nothing (the pause after a wake) does not leave it at
                    // the new value.
                    released(value) => {
                        root.move-slider(index, round(value));
                        self.value = row.position;
                    }
                }
                slider-text := Text {
                    // Follows the slider, also while it is dragged. At the
                    // laptop's stop it shows the laptop's own value.
                    text: round(slider.value) == row.position ? row.text
                        : row.texts[round(slider.value)];
                    width: 84px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.secondary;
                }
            }
        }
    }
    if root.charge-limit-shown: Row {
        title: "Battery charge limit";
        note: root.health == "" ? root.charge-limit-note
            : root.charge-limit-note + " · Health " + root.health;
        Switch {
            accessible-label: "Battery charge limit";
            checked <=> root.charge-limit-on;
            toggled => { root.toggle-charge-limit(); }
        }
    }
    // Read only: shown only when the charge limit row is not.
    if !root.charge-limit-shown && root.health != "": Row {
        title: "Battery health";
        note: root.health;
    }
}
