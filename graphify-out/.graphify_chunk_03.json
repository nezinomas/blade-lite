   "id": "tests_fixtures_13_brightness_0_set_brightness_0x0303",
   "label": "Set LED brightness command (class 03 id 03, storage 01)",
   "file_type": "concept",
   "source_file": "D:\\rust\\synapse\\tests\\fixtures\\13-brightness-0.txt",
   "source_location": null,
   "source_url": null,
   "captured_at": null,
   "author": null,
   "contributor": null,
   "rationale": "Request '03 03 03 01 <led> <value>': every brightness change is sent twice, to LED 0x05 then LED 0x26; value 00..ff (0x80 at 50%, 0xff at 100%, 0x1a at low, 0x03 in the brightness-1 capture)."
